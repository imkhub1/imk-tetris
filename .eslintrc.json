{
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "globals": {
    "Sfx": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "no-eval": "error",
    "no-implied-eval": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": {
        "jest": true,
        "node": true,
        "browser": false
      },
      "globals": {}
    }
  ]
}
